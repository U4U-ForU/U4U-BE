# UFU Backend 환경변수 예시
# 이 파일을 복사해 backend/.env 를 만든다.  cp .env.example .env
# 아래 15개는 하나라도 비어 있으면 애플리케이션이 기동되지 않는다.

# ── Database ──────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/ufu_db
DB_USERNAME=root
DB_PASSWORD=

# ── Redis (refresh token 저장) ────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── CORS ──────────────────────────────────────────────────
# 프론트엔드가 접속하는 주소를 콤마로 구분해 나열한다.
# 끝에 슬래시(/)를 붙이면 매칭되지 않으므로 주의한다.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── JWT ───────────────────────────────────────────────────
# secretKey 는 Base64 로 디코딩되므로 Base64 문자열을 넣는다.
# 예) openssl rand -base64 48
JWT_SECRET_KEY=
ACCESS_EXP=3600
REFRESH_EXP=1209600
HEADER=Authorization
PREFIX=Bearer

# ── AWS S3 (아이템 이미지 저장) ───────────────────────────
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-northeast-2
S3_BUCKET=

# ── 선택 (운영에서는 설정하지 않는다) ─────────────────────
# 값이 없으면 Swagger 는 꺼지고 SQL 로그도 남지 않는다.
# SWAGGER_ENABLED=true
# SQL_LOG_LEVEL=DEBUG
